        },
        "html": "<style>body{margin:0;padding:22px;background:#17191f;color:#ececf3;font:15px system-ui;line-height:1.5}h2,h3,p{margin:0 0 12px}small{color:#a6aabc}button{font:inherit;cursor:pointer;border:0;border-radius:10px;padding:10px 16px}label{display:block;margin:14px 0}input,select{accent-color:#b6a3ff}select{padding:6px;background:#252936;color:#fff;border:1px solid #545c70;border-radius:6px}.card{padding:18px;border:1px solid #383e4f;border-radius:14px;background:#222632}.muted{color:#a6aabc}</style><h3>Try the animation</h3><p class=\"muted\">Tune it, then press Replay. Your control values will be returned.</p><label>Duration <output id=\"duration\">320 ms</output><input id=\"speed\" type=\"range\" min=\"80\" max=\"1000\" step=\"20\" style=\"width:100%\"></label><label>Easing <select id=\"easing\"><option value=\"ease-out\">Ease out</option><option value=\"ease-in-out\">Ease in and out</option><option value=\"linear\">Linear</option></select></label><div style=\"background:#292d39;padding:8px;border-radius:12px;margin:14px 0\"><div id=\"dot\" style=\"width:38px;height:38px;background:#b6a3ff;border-radius:10px\"></div></div><button id=\"replay\" style=\"background:#b6a3ff\">Replay animation</button><script>\nconst speed=document.querySelector('#speed'),easing=document.querySelector('#easing'),dot=document.querySelector('#dot');\nfunction draw(){speed.value=grill.state.duration;easing.value=grill.state.easing;document.querySelector('#duration').textContent=grill.state.duration+' ms'}\nfunction save(){grill.setState({duration:Number(speed.value),easing:easing.value});draw()}\nspeed.oninput=save;easing.onchange=save;\ndocument.querySelector('#replay').onclick=()=>dot.animate([{transform:'translateX(0)'},{transform:'translateX(210px)'},{transform:'translateX(0)'}],{duration:grill.state.duration*2,easing:grill.state.easing});\ndraw();\n</script>"
